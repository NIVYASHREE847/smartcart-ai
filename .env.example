# ---------- Backend (backend/.env or Render environment) ----------
# PostgreSQL URL (Supabase / Render). Leave empty to use local SQLite (backend/data/smartcart.db)
DATABASE_URL=
# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=
# 1 = use SentenceTransformer + FAISS semantic search (requires requirements-embeddings.txt)
USE_EMBEDDINGS=0
# Passwords for the seeded demo accounts (defaults are the documented demo credentials)
DEMO_USER_PASSWORD=
ADMIN_PASSWORD=

# ---------- Frontend (Vercel build environment) ----------
# Public URL of the backend API, without trailing slash
FRONTEND_API_URL=http://localhost:8000
